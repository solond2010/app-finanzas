// WIP (fuera del App Router): cambio de contraseña con hash en settings.
// Sacado de src/app/api/password/ porque importaba hashPassword/verifyPassword
// inexistentes y rompía el build. Requiere completar esas helpers en auth.ts
// y cablear el login para aceptar también el hash en BD antes de reactivar.

import { NextResponse } from "next/server"
import { APP_PASSWORD_SETTING_KEY, hashPassword, timingSafeEqualString, verifyPassword } from "@/lib/auth"
import { supabaseServer } from "@/lib/supabase-server"

// Mismo USER_ID fijo que el resto de la app (ver settings/[key]/route.ts):
// esta es una app personal de un único usuario.
const USER_ID = "8c449806-d8b4-498a-98d7-28809bb7c95a"

const MIN_LENGTH = 6

// Acepta la contraseña actual guardada (hash en BD) o la llave maestra de
// APP_PASSWORD, igual que el login. Así puedes cambiar la contraseña incluso
// si entraste con la maestra por haber olvidado la de la app.
async function isCurrentValid(password: string): Promise<boolean> {
  const { data } = await supabaseServer
    .from("settings")
    .select("value")
    .eq("key", APP_PASSWORD_SETTING_KEY)
    .maybeSingle()
  const storedHash = (data as { value: string } | null)?.value
  if (storedHash && (await verifyPassword(password, storedHash))) return true

  const master = process.env.APP_PASSWORD
  return !!master && timingSafeEqualString(password, master)
}

// Esta ruta ya queda tras el gate del proxy (requiere sesión válida). Aun así,
// exige la contraseña actual como segunda barrera antes de cambiarla.
export async function POST(request: Request) {
  const { currentPassword, newPassword } = await request.json()

  if (typeof currentPassword !== "string" || typeof newPassword !== "string") {
    return NextResponse.json({ error: "Faltan datos" }, { status: 400 })
  }
  if (newPassword.length < MIN_LENGTH) {
    return NextResponse.json({ error: `La nueva contraseña debe tener al menos ${MIN_LENGTH} caracteres` }, { status: 400 })
  }
  if (!(await isCurrentValid(currentPassword))) {
    return NextResponse.json({ error: "La contraseña actual no es correcta" }, { status: 401 })
  }

  const value = await hashPassword(newPassword)
  const { error } = await supabaseServer
    .from("settings")
    .upsert([{ key: APP_PASSWORD_SETTING_KEY, value, user_id: USER_ID }])
  if (error) return NextResponse.json({ error: error.message }, { status: 500 })

  return NextResponse.json({ ok: true })
}
